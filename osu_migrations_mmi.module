<?php

/**
 * @file
 * Pipeline wiring for the MMI second-input migrations.
 */

/**
 * Implements hook_migration_plugins_alter().
 *
 * Inserts mmi_legacy_file_paths after every mmi_media_wysiwyg_filter step in
 * the mmi_* migrations, mirroring what osu_migrations_cas does for the agsci
 * pipelines: first media tokens become <drupal-media>, then hardcoded
 * /sites/mmi7|mmi/files/ URLs left in the text are repaired. Scoped to mmi_*
 * migration ids so the agsci pipelines are never touched.
 */
function osu_migrations_mmi_migration_plugins_alter(array &$migrations) {
  foreach ($migrations as $id => &$migration) {
    if (!str_starts_with((string) $id, 'mmi_') || !is_array($migration['process'] ?? NULL)) {
      continue;
    }
    foreach ($migration['process'] as &$pipeline) {
      $pipeline = _osu_migrations_mmi_append_legacy_paths($pipeline);
    }
    unset($pipeline);
  }
  unset($migration);
}

/**
 * Appends the legacy-paths repair after each mmi_media_wysiwyg_filter step.
 *
 * Walks one process pipeline (plugin list, single plugin, or sub_process
 * nesting) and returns the rewritten definition.
 */
function _osu_migrations_mmi_append_legacy_paths($pipeline) {
  if (!is_array($pipeline)) {
    return $pipeline;
  }
  $single = array_keys($pipeline) !== range(0, count($pipeline) - 1);
  $steps = $single ? [$pipeline] : $pipeline;
  $result = [];
  foreach ($steps as $step) {
    if (is_array($step) && ($step['plugin'] ?? NULL) === 'sub_process' && is_array($step['process'] ?? NULL)) {
      foreach ($step['process'] as &$nested) {
        $nested = _osu_migrations_mmi_append_legacy_paths($nested);
      }
      unset($nested);
    }
    $result[] = $step;
    if (is_array($step) && ($step['plugin'] ?? NULL) === 'mmi_media_wysiwyg_filter') {
      $result[] = ['plugin' => 'mmi_legacy_file_paths'];
    }
  }
  return count($result) === 1 && $single ? $result[0] : $result;
}
